# ==============================================================================
# VoxClone CLI Environment Configuration Template
# Copy this file to .env to customize local runtime behaviors.
# ==============================================================================

# Directory Paths
VOXCLONE_DATA_DIR=/app/data
VOXCLONE_PROFILES_DIR=/app/profiles
VOXCLONE_OUTPUTS_DIR=/app/outputs
VOXCLONE_INPUTS_DIR=/app/inputs
VOXCLONE_WORK_DIR=/app/data/work

# Engine Execution Mode: "real" for AI GPU pipelines, "fake" for offline deterministic tests
VOXCLONE_ENGINE=real

# Logging Verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL
VOXCLONE_LOG_LEVEL=INFO

# Speaker Consent Safety Gate: Enforces speaker consent confirmation (Immutable; must remain 1)
VOXCLONE_REQUIRE_CONSENT=1

# Display Flags: Set to 1 to force ASCII icons or disable ANSI terminal colors
# VOXCLONE_PLAIN=0
# NO_COLOR=0

# Model Cache & Offline Enforcement
HF_HOME=/models
HF_HUB_OFFLINE=1

# Audio Interop: WSLg PulseAudio UNIX domain socket for microphone and speakers
PULSE_SERVER=unix:/mnt/wslg/PulseServer

# ==============================================================================
# Execution Backend Topology
# "local"        -> Runs neural inference locally (NVIDIA CUDA or CPU fallback)
# "remote_drive" -> Offloads neural inference to Google Colab T4 GPU via Google Drive queue
# ==============================================================================
VOXCLONE_BACKEND=local
# Path to Google Drive synced folder when using VOXCLONE_BACKEND=remote_drive
# VOXCLONE_DRIVE_DIR="C:/Users/ACER/Google Drive/My Drive/voxclone_queue"

# ==============================================================================
# Engine Tunables (Database Overrides)
# Note: When uncommented and set here, the environment takes absolute precedence over
# the values stored in the SQLite `app_settings` table, and the Settings UI shows them as locked.
# ==============================================================================
# Hardware acceleration device: "auto", "cuda", or "cpu"
# On AMD Radeon / Ryzen APU systems, set to "cpu" for local runs, or use VOXCLONE_BACKEND=remote_drive
# VOXCLONE_DEVICE=cpu
# VOXCLONE_WORKERS=0
# VOXCLONE_VRAM_BUDGET_MB=6000
# VOXCLONE_KEEP_WARM=1
# VOXCLONE_CHUNK_MIN_SEC=3.0
# VOXCLONE_CHUNK_MAX_SEC=5.0
# VOXCLONE_CROSSFADE_MS=30
# VOXCLONE_SENTENCE_MAX_CHARS=200

